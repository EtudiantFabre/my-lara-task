{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "environment": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://my-lara-task.vercel.app/",
        "APP_KEY": "base64:t2w3W+JrBkrk5zFOKJEnBAui2ePBwIifuwROZMwd5C4=",
        "CACHE_DRIVER": "file",
        "LOG_CHANNEL": "single"
      }
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "builds": [
    {
      "src": "public/index.php",
      "use": "vercel-php@0.7.4",
      "config": {
        "command": "mkdir -p /tmp/framework/cache/data /tmp/bootstrap/cache && composer install && npm ci --legacy-peer-deps && npm run build"
      }
    }
  ]
}