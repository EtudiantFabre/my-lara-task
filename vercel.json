{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "builds": [
    {
      "src": "vite.config.js",
      "use": "@vercel/static-build",
      "config": { "distDir": "public" }
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(favicon\\.ico|robots\\.txt)",
      "dest": "/public/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_URL": "https://my-lara-task.vercel.app/",
    "APP_KEY": "base64:t2w3W+JrBkrk5zFOKJEnBAui2ePBwIifuwROZMwd5C4=",
    "CACHE_STORE": "database",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp",
    "DB_CONNECTION": "pgsql",
    "DATABASE_URL" : "postgresql://neondb_owner:npg_jH2pluitfX8o@ep-holy-recipe-adefk6aw-pooler.c-2.us-east-1.aws.neon.tech/tasks?sslmode=require",
    "DATABASE_URL_UNPOOLED": "postgresql://neondb_owner:npg_jH2pluitfX8o@ep-holy-recipe-adefk6aw-pooler.c-2.us-east-1.aws.neon.tech/tasks?sslmode=require"
  }
}